{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "state_directory": "tailscale",
      "accept_routes": true
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "hosts_fix",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
          "doh.pub": ["1.12.12.21", "120.53.53.53"],
          "dns.google": ["8.8.8.8", "8.8.4.4"],
          "cloudflare-dns.com": ["104.16.248.249", "104.16.249.249"]
        }
      },
      {
        "type": "tailscale",
        "tag": "ts",
        "endpoint": "ts-ep",
        "accept_default_resolvers": false,
        "accept_search_domain": false
      },
      {"tag": "cf-doh", "type": "https", "server": "cloudflare-dns.com", "detour": "Proxy", "domain_resolver": "hosts_fix"},
      {"tag": "ali-doh", "type": "https", "server": "dns.alidns.com", "domain_resolver": "hosts_fix"},
      {"tag": "ali-udp", "type": "udp", "server": "223.5.5.5"},
      {"tag": "remote", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18"},
      {"tag": "local", "type": "local", "neighbor_domain": [".local", ".lan"]}
    ],
    "rules": [
      {
        "preferred_by": "ts",
        "action": "route",
        "server": "ts"
      },
      {"domain_suffix": [".ts.net"], "server": "ts"},
      {"rule_set": ["Reject"], "action": "predefined"},
      {"rule_set": ["AppleCN"], "action": "route", "server": "ali-doh"},
      {"rule_set": ["ChinaDomain"], "query_type": ["A", "AAAA"], "action": "route", "server": "ali-udp", "timeout": "3s"},
      {"domain_suffix": ["lancache.steamcontent.com", "local", "lan", "home"], "server": "local"},
      {"query_type": ["A", "AAAA"], "action": "route", "server": "remote", "rewrite_ttl": 1}
    ],
    "optimistic": true,
    "strategy": "prefer_ipv4",
    "final": "ali-doh"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": false,
      "sniff": true,
      "sniff_override_destination": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {"tag": "Direct", "type": "direct"},
    {"tag": "Proxy", "type": "selector", "outbounds": ["HongKong", "United States", "Singapore", "Japan", "Taiwan", "Others", "Direct"], "default": "Direct", "interrupt_exist_connections": true},
    {"tag": "AI", "type": "selector", "outbounds": ["Proxy", "HongKong", "United States", "Singapore", "Japan", "Taiwan"], "default": "United States", "interrupt_exist_connections": true},
    {"tag": "Google", "type": "selector", "outbounds": ["Proxy", "HongKong", "United States", "Singapore", "Japan", "Taiwan"], "default": "United States", "interrupt_exist_connections": true},
    {"tag": "Telegram", "type": "selector", "outbounds": ["Proxy", "HongKong", "United States", "Singapore", "Japan", "Taiwan"], "default": "HongKong", "interrupt_exist_connections": true},
    {"tag": "Streaming", "type": "selector", "outbounds": ["Proxy", "HongKong", "United States", "Singapore", "Japan", "Taiwan"], "interrupt_exist_connections": true},
    {"tag": "HongKong", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇭🇰|HK|hk|香港|港|HongKong"]}]},
    {"tag": "Taiwan", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇹🇼|TW|tw|台湾|臺灣|台|Taiwan"]}]},
    {"tag": "United States", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇺🇸|US|us|美国|美|United States"]}]},
    {"tag": "Singapore", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇸🇬|SG|sg|新加坡|狮|Singapore"]}]},
    {"tag": "Japan", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇯🇵|JP|jp|日本|日|Japan"]}]},
    {"tag": "Others", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["🇭🇰|HK|hk|香港|香|🇹🇼|TW|tw|台湾|台|🇸🇬|SG|sg|新加坡|狮|🇯🇵|JP|jp|日本|日|🇺🇸|US|us|美国|美"]}]},
    {"tag": "Auto", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["网站|地址|剩余|过期|时间|有效"]}], "url": "http://www.gstatic.com/generate_204", "interval": "10m", "tolerance": 50}
  ],
  "route": {
    "default_domain_resolver": "ali-udp",
    "auto_detect_interface": true,
    "find_process": true,
    "final": "Proxy",
    "rules": [
      {"action": "sniff"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {"domain_suffix": ["ts.net", "tailscale.com"], "action": "route", "outbound": "Direct"},
      {"ip_cidr": ["100.64.0.0/10"], "action": "route", "outbound": "Direct"},
      {"rule_set": ["AppleCN"], "action": "route", "outbound": "Direct"},
      {"rule_set": ["AI"], "action": "route", "outbound": "AI"},
      {"rule_set": ["Telegram"], "action": "route", "outbound": "Telegram"},
      {"rule_set": ["Google", "YouTube", "Github"], "action": "route", "outbound": "Google"},
      {"rule_set": ["Netflix", "Disney", "PrimeVideo", "HBO", "Bahamut"], "action": "route", "outbound": "Streaming"},
      {"rule_set": ["ChinaDomain"], "action": "route", "outbound": "Direct"},
      {"rule_set": ["Proxy"], "action": "route", "outbound": "Proxy"},
      {"action": "resolve"},
      {"rule_set": ["ChinaIP"], "action": "route", "outbound": "Direct"},
      {"ip_is_private": true, "action": "route", "outbound": "Direct"}
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "Reject", "Ads_AWAvenue", "Proxy",
          "AI", "Telegram", "Google", "YouTube", "Github",
          "Netflix", "Disney", "PrimeVideo", "HBO", "Bahamut",
          "AppleCN", "ChinaDomain", "ChinaIP"
        ],
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "update_interval": "24h"
      }
    ]
  }
}
